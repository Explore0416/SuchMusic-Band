<template>
  <div class="page">
    <!-- 头部行 -->
    <div class="head-row">
      <div class="back-chip" onclick="back"><text class="back-text">返回</text></div>
      <text class="head-title">搜索</text>
      <text class="head-side">{{ linkText }}</text>
    </div>

    <!-- 输入框：点按弹出手环内置键盘（Vela 无系统输入法，快应用必须自绘键盘） -->
    <div class="search-box" onclick="openKb">
      <text class="search-box-text" if="{{ keyword }}">{{ keyword }}</text>
      <text class="search-box-text search-ph" if="{{ !keyword }}">点此输入歌名</text>
    </div>

    <!-- ── 键盘模式 ── -->
    <div class="kb" if="{{ kbOpen }}">
      <div class="kb-row">
        <div class="key" onclick="type('A')"><text class="key-text">A</text></div>
        <div class="key" onclick="type('B')"><text class="key-text">B</text></div>
        <div class="key" onclick="type('C')"><text class="key-text">C</text></div>
        <div class="key" onclick="type('D')"><text class="key-text">D</text></div>
        <div class="key" onclick="type('E')"><text class="key-text">E</text></div>
      </div>
      <div class="kb-row">
        <div class="key" onclick="type('F')"><text class="key-text">F</text></div>
        <div class="key" onclick="type('G')"><text class="key-text">G</text></div>
        <div class="key" onclick="type('H')"><text class="key-text">H</text></div>
        <div class="key" onclick="type('I')"><text class="key-text">I</text></div>
        <div class="key" onclick="type('J')"><text class="key-text">J</text></div>
      </div>
      <div class="kb-row">
        <div class="key" onclick="type('K')"><text class="key-text">K</text></div>
        <div class="key" onclick="type('L')"><text class="key-text">L</text></div>
        <div class="key" onclick="type('M')"><text class="key-text">M</text></div>
        <div class="key" onclick="type('N')"><text class="key-text">N</text></div>
        <div class="key" onclick="type('O')"><text class="key-text">O</text></div>
      </div>
      <div class="kb-row">
        <div class="key" onclick="type('P')"><text class="key-text">P</text></div>
        <div class="key" onclick="type('Q')"><text class="key-text">Q</text></div>
        <div class="key" onclick="type('R')"><text class="key-text">R</text></div>
        <div class="key" onclick="type('S')"><text class="key-text">S</text></div>
        <div class="key" onclick="type('T')"><text class="key-text">T</text></div>
      </div>
      <div class="kb-row">
        <div class="key" onclick="type('U')"><text class="key-text">U</text></div>
        <div class="key" onclick="type('V')"><text class="key-text">V</text></div>
        <div class="key" onclick="type('W')"><text class="key-text">W</text></div>
        <div class="key" onclick="type('X')"><text class="key-text">X</text></div>
        <div class="key" onclick="type('Y')"><text class="key-text">Y</text></div>
      </div>
      <div class="kb-row">
        <div class="key" onclick="type('Z')"><text class="key-text">Z</text></div>
        <div class="key key-wide" onclick="del"><text class="key-text-wide">删除</text></div>
        <div class="key key-wide key-accent" onclick="submit"><text class="key-text-wide">搜索</text></div>
      </div>
    </div>

    <!-- ── 浏览模式：热搜 / 最近 / 结果 ── -->
    <div class="col" if="{{ !kbOpen }}">
      <text class="meta" style="margin-top: 8px;">热搜</text>
      <div class="chip-wrap">
        <div class="chip" for="{{ hot }}" onclick="searchHot($item)">
          <text class="chip-text">{{ $item }}</text>
        </div>
      </div>

      <text class="meta" style="margin-top: 6px;">最近</text>
      <div class="col">
        <div class="list-item" for="{{ history }}" onclick="searchHot($item)">
          <text class="list-title">{{ $item }}</text>
          <div class="del-chip" onclick="removeHistory($item)"><text class="del-text">删</text></div>
        </div>
      </div>

      <div class="divider" style="margin-top: 4px;"></div>

      <text class="meta" style="margin-top: 4px;">结果（{{ results.length }}）</text>
      <list class="list">
        <list-item type="result" class="list-item" for="{{ results }}" onclick="playResult($index)">
          <text class="list-index">{{ $index + 1 }}</text>
          <div class="list-main">
            <text class="list-title">{{ $item.name }}</text>
            <text class="list-sub">{{ $item.artist }}</text>
          </div>
        </list-item>
      </list>
      <div class="meta" if="{{ results.length === 0 }}" style="margin-top: 4px;">{{ emptyText }}</div>
    </div>
  </div>
</template>

<style>
@import '../../common/style.css';
</style>

<script>
import router from '@system.router'
import rpcMod from '../../utils/rpc.js'
import state from '../../utils/state.js'
import ui from '../../utils/ui.js'
import format from '../../utils/format.js'
import store from '../../utils/store.js'
import consts from '../../common/const.js'

export default {
  data: {
    connected: false,
    linkText: consts.TEXT.disconnected,
    hot: [],
    history: [],
    results: [],
    keyword: '',
    kbOpen: false,
    emptyText: consts.TEXT.noResult
  },

  onInit() {
    this._unsubState = state.subscribe(() => this.refresh())
    this._unsubEvt = null
    const rpc = rpcMod.getRpc()
    if (rpc) {
      // 监听手机「发送到手环」→ search.preset；自动以其为关键词搜索
      this._unsubEvt = rpc.onEvent((name, payload) => {
        if (name === 'search.preset' && payload && payload.keyword) {
          store.instance.pushHistory(payload.keyword)
          this.keyword = payload.keyword
          this.kbOpen = false
          this.refresh()
          this.doSearch(payload.keyword)
        }
      })
      rpc.searchHot((r) => {
        if (r.ok && r.payload && r.payload.items) {
          state.applyEvent('search.hot', r.payload)
        }
      })
    }
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onDestroy() {
    if (this._unsubState) { this._unsubState() }
    if (this._unsubEvt) { this._unsubEvt() }
  },

  refresh() {
    const s = state.get()
    this.connected = s.link === 'ready'
    this.linkText = consts.LINK_TEXT[s.link] || consts.TEXT.disconnected
    this.hot = s.searchHot.slice(0, 6)
    this.history = store.instance.getHistory()
    this.results = s.searchResults.map((r) => ({
      id: r.id,
      name: format.ellipsize(r.name || '', 16),
      artist: format.ellipsize(format.artistAlbum(r.artist, r.album), 20)
    }))
  },

  back() {
    if (this.kbOpen) { this.kbOpen = false; return }
    console.log('[ui] search back')
    router.back()
  },

  openKb() {
    this.kbOpen = true
  },

  type(ch) {
    if (this.keyword.length >= 20) { return }
    this.keyword = this.keyword + ch
  },

  del() {
    this.keyword = this.keyword.slice(0, Math.max(0, this.keyword.length - 1))
  },

  submit() {
    const kw = (this.keyword || '').trim()
    if (!kw) { return }
    this.kbOpen = false
    this.doSearch(kw)
  },

  searchHot(kw) {
    this.keyword = kw
    this.doSearch(kw)
  },

  removeHistory(kw) {
    store.instance.removeHistory(kw)
    this.refresh()
  },

  doSearch(keyword) {
    if (ui.offlineToast(state)) { return }
    const rpc = rpcMod.getRpc()
    if (!rpc || !keyword) { return }
    store.instance.pushHistory(keyword)
    this.emptyText = consts.TEXT.loading
    rpc.searchSong(keyword, consts.LIMITS.searchLimit, (r) => {
      if (r.ok && r.payload) {
        if (r.payload.results) {
          state.applyEvent('search.result', { results: r.payload.results })
        }
      } else {
        this.emptyText = consts.TEXT.noResult
      }
      this.refresh()
    })
  },

  // 选中结果 → 播放并回首页
  playResult(index) {
    if (ui.offlineToast(state)) { return }
    const rpc = rpcMod.getRpc()
    if (!rpc) { return }
    rpc.queuePlay(index, () => {
      router.back()
    })
  }
}
</script>
