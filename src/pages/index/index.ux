<template>
  <div class="page">

    <!-- 标定探针：100/150/200px，用于测量 CSS px → 物理 px 映射 -->
    <!-- 状态行：连接状态点 + 文案（右侧仅在启动异常时显示一行诊断） -->
    <div class="status-row">
      <div class="dot {{ connected ? 'dot-on' : 'dot-off' }}"></div>
      <text class="status-text">{{ linkText }}</text>
      <text class="status-right">{{ initError }}</text>
    </div>

    <!-- 主控制区：上一 / 播放暂停 / 下一（图标为 PNG，真机对符号字形渲染不可靠） -->
    <div class="ctrl-row">
      <div class="side-btn" onclick="prev">
        <image class="ic-side" src="/common/ic_prev.png"></image>
      </div>
      <div class="main-btn {{ playing ? '' : 'main-btn-off' }}" onclick="toggle">
        <image if="{{ playing }}" class="ic-main" src="/common/ic_pause.png"></image>
        <image if="{{ !playing }}" class="ic-main-off" src="/common/ic_play.png"></image>
      </div>
      <div class="side-btn" onclick="next">
        <image class="ic-side" src="/common/ic_next.png"></image>
      </div>
    </div>

    <!-- 曲目信息（点击区为 div，进入控制页） -->
    <div class="song-block" onclick="goControl">
      <text class="song-title">{{ songName }}</text>
      <text class="song-artist">{{ artistAlbum }}</text>
    </div>

    <!-- 进度 -->
    <div class="progress-wrap">
      <div class="progress-track">
        <div class="progress-fill" style="width: {{ progressWidth }};"></div>
      </div>
      <div class="time-row">
        <text class="time-text">{{ positionText }}</text>
        <text class="time-text time-right">{{ durationText }}</text>
      </div>
    </div>

    <!-- 底部导航 -->
    <div class="nav-row">
      <div class="nav-cell" onclick="goSearch">
        <image class="ic-nav" src="/common/ic_search.png"></image>
        <text class="nav-label">搜索</text>
      </div>
      <div class="nav-cell" onclick="goMode">
        <image class="ic-nav" src="/common/ic_mode.png"></image>
        <text class="nav-label">模式</text>
      </div>
      <div class="nav-cell" onclick="goLyric">
        <image class="ic-nav" src="/common/ic_lyric.png"></image>
        <text class="nav-label">歌词</text>
      </div>
    </div>
  </div>
</template>

<style>
@import '../../common/style.css';
</style>

<script>
import router from '@system.router'
import rpcMod from '../../utils/rpc.js'
import state from '../../utils/state.js'
import ui from '../../utils/ui.js'
import format from '../../utils/format.js'
import consts from '../../common/const.js'

export default {
  data: {
    brand: consts.TEXT.brand,
    connected: false,
    linkText: consts.TEXT.disconnected,
    songName: consts.TEXT.emptySong,
    artistAlbum: consts.TEXT.emptyArtist,
    positionText: '00:00',
    durationText: '00:00',
    progressWidth: '0%',
    playing: false,
    initError: ''
  },

  onInit() {
    this._unsub = state.subscribe(() => this.refresh())
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onDestroy() {
    if (this._unsub) { this._unsub() }
  },

  /**
   * 从全局 state 读取并刷新视图（页面不做编解码、不直连 interconnect）。
   */
  refresh() {
    const s = state.get()
    this.connected = s.link === 'ready'
    this.linkText = consts.LINK_TEXT[s.link] || consts.TEXT.disconnected
    this.playing = !!s.playing
    this.initError = s.initError || ''

    if (s.song) {
      this.songName = format.ellipsize(s.song.name || consts.TEXT.emptySong, 20)
      this.artistAlbum = format.ellipsize(format.artistAlbum(s.song.artist, s.song.album), 26) || consts.TEXT.emptyArtist
    } else {
      this.songName = consts.TEXT.emptySong
      this.artistAlbum = consts.TEXT.emptyArtist
    }
    this.positionText = format.formatTime(s.positionMs)
    this.durationText = format.formatTime(s.durationMs)
    this.progressWidth = format.widthPercent(format.progressRatio(s.positionMs, s.durationMs))
  },

  goControl() { console.log('[ui] tap goControl'); router.push({ uri: consts.ROUTES.CONTROL }) },
  goSearch() { console.log('[ui] tap goSearch'); router.push({ uri: consts.ROUTES.SEARCH }) },
  goMode() { console.log('[ui] tap goMode'); router.push({ uri: consts.ROUTES.MODE }) },
  goLyric() { console.log('[ui] tap goLyric'); router.push({ uri: consts.ROUTES.LYRIC }) },

  toggle() {
    console.log('[ui] tap toggle, playing=' + this.playing)
    if (ui.offlineToast(state)) { return }
    const rpc = rpcMod.getRpc()
    if (!rpc) { return }
    // 显式 play/pause（优先于 playback.toggle，§3.5）
    if (this.playing) { rpc.pause() } else { rpc.play() }
  },
  prev() {
    console.log('[ui] tap prev')
    if (ui.offlineToast(state)) { return }
    const rpc = rpcMod.getRpc()
    if (rpc) { rpc.prev() }
  },
  next() {
    console.log('[ui] tap next')
    if (ui.offlineToast(state)) { return }
    const rpc = rpcMod.getRpc()
    if (rpc) { rpc.next() }
  }
}
</script>
