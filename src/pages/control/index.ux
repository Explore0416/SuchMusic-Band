<template>
  <div class="page">
    <!-- 头部行：返回块（div 点击区） + 标题 -->
    <div class="head-row">
      <div class="back-chip" onclick="back"><text class="back-text">返回</text></div>
      <text class="head-title">正在播放</text>
    </div>

    <!-- 曲目 -->
    <div class="song-block">
      <text class="song-title">{{ songName }}</text>
      <text class="song-artist">{{ artistAlbum }}</text>
    </div>

    <!-- 可点进度条 → playback.seek（点击区为 div） -->
    <div class="progress-track" onclick="onSeek">
      <div class="progress-fill" style="width: {{ progressWidth }};"></div>
    </div>
    <div class="time-row">
      <text class="time-text">{{ positionText }}</text>
      <text class="time-text time-right">{{ durationText }}</text>
    </div>

    <!-- 主控制区：上一 / 播放暂停 / 下一（图标 PNG） -->
    <div class="ctrl-row">
      <div class="side-btn" onclick="prev">
        <image class="ic-side" src="/common/ic_prev.png"></image>
      </div>
      <div class="main-btn {{ playing ? '' : 'main-btn-off' }}" onclick="toggle">
        <image if="{{ playing }}" class="ic-main" src="/common/ic_pause.png"></image>
        <image if="{{ !playing }}" class="ic-main-off" src="/common/ic_play.png"></image>
      </div>
      <div class="side-btn" onclick="next">
        <image class="ic-side" src="/common/ic_next.png"></image>
      </div>
    </div>

    <!-- 播放列表入口 -->
    <div class="entry-bar" onclick="goMode">
      <text class="entry-text">播放列表 {{ queueCount }} 首 · 当前 {{ currentIndexText }}</text>
    </div>
  </div>
</template>

<style>
@import '../../common/style.css';
</style>

<script>
import router from '@system.router'
import rpcMod from '../../utils/rpc.js'
import state from '../../utils/state.js'
import ui from '../../utils/ui.js'
import format from '../../utils/format.js'
import modeUtil from '../../utils/mode.js'
import consts from '../../common/const.js'

// 设计坐标：页面宽 106 逻辑单位（=212 物理 px）
const PAGE_LOGICAL_WIDTH = 106

export default {
  data: {
    songName: consts.TEXT.emptySong,
    artistAlbum: consts.TEXT.emptyArtist,
    positionText: '00:00',
    durationText: '00:00',
    progressWidth: '0%',
    playing: false,
    mode: 'loop',
    modeGlyph: modeUtil.shortLabel('loop'),
    queueCount: 0,
    currentIndexText: '-',
    durationMs: 0
  },

  onInit() {
    this._unsub = state.subscribe(() => this.refresh())
    this.refresh()
  },

  onDestroy() {
    if (this._unsub) { this._unsub() }
  },

  refresh() {
    const s = state.get()
    this.playing = !!s.playing
    this.mode = s.mode
    this.modeGlyph = modeUtil.shortLabel(s.mode)
    this.queueCount = s.queue ? s.queue.count : 0
    const ci = s.queue ? s.queue.currentIndex : -1
    this.currentIndexText = ci >= 0 ? (ci + 1) : '-'
    this.durationMs = s.durationMs
    if (s.song) {
      this.songName = format.ellipsize(s.song.name || consts.TEXT.emptySong, 18)
      this.artistAlbum = format.ellipsize(format.artistAlbum(s.song.artist, s.song.album), 24) || consts.TEXT.emptyArtist
    }
    this.positionText = format.formatTime(s.positionMs)
    this.durationText = format.formatTime(s.durationMs)
    this.progressWidth = format.widthPercent(format.progressRatio(s.positionMs, s.durationMs))
  },

  back() { console.log('[ui] control back'); router.back() },
  goMode() { console.log('[ui] control goMode'); router.push({ uri: consts.ROUTES.MODE }) },

  toggle() {
    console.log('[ui] control toggle, playing=' + this.playing)
    if (ui.offlineToast(state)) { return }
    const rpc = rpcMod.getRpc()
    if (!rpc) { return }
    if (this.playing) { rpc.pause() } else { rpc.play() }
  },
  prev() { console.log('[ui] control prev'); if (ui.offlineToast(state)) { return }; const r = rpcMod.getRpc(); if (r) { r.prev() } },
  next() { console.log('[ui] control next'); if (ui.offlineToast(state)) { return }; const r = rpcMod.getRpc(); if (r) { r.next() } },

  setLoop() { console.log('[ui] control setLoop'); this._setMode('loop') },
  setSingle() { console.log('[ui] control setSingle'); this._setMode('single') },
  setShuffle() { console.log('[ui] control setShuffle'); this._setMode('shuffle') },
  _setMode(m) {
    if (ui.offlineToast(state)) { return }
    const rpc = rpcMod.getRpc()
    if (rpc) { rpc.setMode(m) }
  },

  /**
   * 进度条点击 → seek。按点击 X 比例换算目标位置（设计 §5 线框 ②）。
   * 真机为拖动手势时，touches[0].clientX 给出坐标；无坐标信息则忽略。
   */
  onSeek(e) {
    if (ui.offlineToast(state)) { return }
    const rpc = rpcMod.getRpc()
    if (!rpc || !this.durationMs) { return }
    let x = null
    try {
      if (e && e.touches && e.touches[0] && typeof e.touches[0].clientX === 'number') {
        x = e.touches[0].clientX
      } else if (e && typeof e.offsetX === 'number') {
        x = e.offsetX
      }
    } catch (err) { x = null }
    if (x === null) { return }
    // 逻辑坐标：屏幕宽 106，左右各留 8 边距
    const usable = PAGE_LOGICAL_WIDTH - 16
    let ratio = (x) / usable
    ratio = format.clamp(ratio, 0, 1)
    rpc.seek(Math.round(ratio * this.durationMs))
  }
}
</script>
