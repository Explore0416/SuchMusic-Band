<template>
  <div class="page">
    <!-- 顶部栏 -->
    <div class="topbar">
      <text class="topbar-back" onclick="back">返回</text>
      <text class="topbar-title">正在播放</text>
      <text class="meta">{{ modeGlyph }}</text>
    </div>

    <!-- 曲目 -->
    <div class="col" style="margin-top: 4px;">
      <text class="title-h2 ellipsis center">{{ songName }}</text>
      <text class="caption ellipsis center mt4">{{ artistAlbum }}</text>
    </div>

    <!-- 可点进度条 → playback.seek -->
    <div class="col mt8" onclick="onSeek">
      <div class="progress-track">
        <div class="progress-fill" style="width: {{ progressWidth }};"></div>
      </div>
      <div class="row" style="justify-content: space-between; margin-top: 4px;">
        <text class="meta">{{ positionText }}</text>
        <text class="meta">{{ durationText }}</text>
      </div>
    </div>

    <!-- 三个大键（中文文本，避免符号字形在真机不渲染） -->
    <div class="row mt8" style="justify-content: space-around;">
      <text class="tbtn" onclick="prev">上一首</text>
      <text class="tbtn tbtn-primary {{ playing ? '' : 'tbtn-off' }}" onclick="toggle">{{ playing ? '暂停' : '播放' }}</text>
      <text class="tbtn" onclick="next">下一首</text>
    </div>

    <!-- 模式快捷切换 -->
    <div class="row mt8" style="justify-content: center;">
      <text class="chip {{ mode === 'single' ? 'chip-accent' : '' }}" onclick="setSingle">单曲循环</text>
      <text class="chip {{ mode === 'loop' ? 'chip-accent' : '' }}" onclick="setLoop">顺序</text>
      <text class="chip {{ mode === 'shuffle' ? 'chip-accent' : '' }}" onclick="setShuffle">乱序</text>
    </div>

    <div class="grow"></div>

    <!-- 播放列表入口 -->
    <div class="card-flat list-item" style="justify-content: center;" onclick="goMode">
      <text class="body">播放列表 {{ queueCount }} 首 · 当前 {{ currentIndexText }}</text>
    </div>
  </div>
</template>

<style>
@import '../../common/style.css';
</style>

<script>
import router from '@system.router'
import rpcMod from '../../utils/rpc.js'
import state from '../../utils/state.js'
import format from '../../utils/format.js'
import modeUtil from '../../utils/mode.js'
import consts from '../../common/const.js'

// 设计坐标：页面宽 106 逻辑单位（=212 物理 px）
const PAGE_LOGICAL_WIDTH = 106

export default {
  data: {
    songName: consts.TEXT.emptySong,
    artistAlbum: consts.TEXT.emptyArtist,
    positionText: '00:00',
    durationText: '00:00',
    progressWidth: '0%',
    playing: false,
    mode: 'loop',
    modeGlyph: modeUtil.shortLabel('loop'),
    queueCount: 0,
    currentIndexText: '-',
    durationMs: 0
  },

  onInit() {
    this._unsub = state.subscribe(() => this.refresh())
    this.refresh()
  },

  onDestroy() {
    if (this._unsub) { this._unsub() }
  },

  refresh() {
    const s = state.get()
    this.playing = !!s.playing
    this.mode = s.mode
    this.modeGlyph = modeUtil.shortLabel(s.mode)
    this.queueCount = s.queue ? s.queue.count : 0
    const ci = s.queue ? s.queue.currentIndex : -1
    this.currentIndexText = ci >= 0 ? (ci + 1) : '-'
    this.durationMs = s.durationMs
    if (s.song) {
      this.songName = format.ellipsize(s.song.name || consts.TEXT.emptySong, 18)
      this.artistAlbum = format.ellipsize(format.artistAlbum(s.song.artist, s.song.album), 24) || consts.TEXT.emptyArtist
    }
    this.positionText = format.formatTime(s.positionMs)
    this.durationText = format.formatTime(s.durationMs)
    this.progressWidth = format.widthPercent(format.progressRatio(s.positionMs, s.durationMs))
  },

  back() { router.back() },
  goMode() { router.push({ uri: consts.ROUTES.MODE }) },

  toggle() {
    const rpc = rpcMod.getRpc()
    if (!rpc) { return }
    if (this.playing) { rpc.pause() } else { rpc.play() }
  },
  prev() { const r = rpcMod.getRpc(); if (r) { r.prev() } },
  next() { const r = rpcMod.getRpc(); if (r) { r.next() } },

  setLoop() { this._setMode('loop') },
  setSingle() { this._setMode('single') },
  setShuffle() { this._setMode('shuffle') },
  _setMode(m) {
    const rpc = rpcMod.getRpc()
    if (rpc) { rpc.setMode(m) }
  },

  /**
   * 进度条点击 → seek。按点击 X 比例换算目标位置（设计 §5 线框 ②）。
   * 真机为拖动手势时，touches[0].clientX 给出坐标；无坐标信息则忽略。
   */
  onSeek(e) {
    const rpc = rpcMod.getRpc()
    if (!rpc || !this.durationMs) { return }
    let x = null
    try {
      if (e && e.touches && e.touches[0] && typeof e.touches[0].clientX === 'number') {
        x = e.touches[0].clientX
      } else if (e && typeof e.offsetX === 'number') {
        x = e.offsetX
      }
    } catch (err) { x = null }
    if (x === null) { return }
    // 逻辑坐标：屏幕宽 106，左右各留 8 边距
    const usable = PAGE_LOGICAL_WIDTH - 16
    let ratio = (x) / usable
    ratio = format.clamp(ratio, 0, 1)
    rpc.seek(Math.round(ratio * this.durationMs))
  }
}
</script>
