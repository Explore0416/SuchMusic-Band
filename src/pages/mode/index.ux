<template>
  <div class="page">
    <!-- 头部行：返回块（div 点击区） + 标题 -->
    <div class="head-row">
      <div class="back-chip" onclick="back"><text class="back-text">返回</text></div>
      <text class="head-title">播放模式</text>
    </div>

    <!-- 三选一：顺序 / 单曲 / 乱序 -->
    <div class="card col" style="padding: 0;">
      <div class="list-item" for="{{ modes }}" onclick="choose($item.mode)">
        <div class="pick {{ $item.selected ? 'pick-on' : '' }}"></div>
        <text class="body grow">{{ $item.label }}</text>
        <text class="meta accent">{{ $item.selected ? '使用中' : '' }}</text>
      </div>
    </div>

    <!-- 播放列表（协议仅提供 count/currentIndex，见 README 偏差 E2） -->
    <div class="col mt8">
      <text class="meta">播放列表（{{ queueCount }}）</text>
    </div>
    <list class="list">
      <list-item type="queue" class="list-item {{ $item.current ? 'list-item-current' : '' }}"
                 for="{{ queueList }}" onclick="play($item.index)">
        <div class="{{ $item.current ? 'current-bar' : '' }}"></div>
        <text class="list-index">{{ $item.index + 1 }}</text>
        <div class="list-main">
          <text class="list-title ellipsis">{{ $item.label }}</text>
        </div>
      </list-item>
    </list>
    <div class="grow" if="{{ queueCount === 0 }}">
      <text class="meta center">队列为空</text>
    </div>
  </div>
</template>

<style>
@import '../../common/style.css';
</style>

<script>
import router from '@system.router'
import rpcMod from '../../utils/rpc.js'
import state from '../../utils/state.js'
import ui from '../../utils/ui.js'
import modeUtil from '../../utils/mode.js'
import store from '../../utils/store.js'

export default {
  data: {
    modes: [],
    modeGlyph: modeUtil.shortLabel('loop'),
    queueCount: 0,
    queueList: []
  },

  onInit() {
    this._unsub = state.subscribe(() => this.refresh())
    this.refresh()
  },

  onDestroy() {
    if (this._unsub) { this._unsub() }
  },

  refresh() {
    const s = state.get()
    this.modes = modeUtil.list(s.mode)
    this.modeGlyph = modeUtil.shortLabel(s.mode)
    const q = s.queue || { count: 0, currentIndex: -1 }
    this.queueCount = q.count
    const list = []
    for (let i = 0; i < q.count; i++) {
      list.push({
        index: i,
        label: '第 ' + (i + 1) + ' 首',
        current: i === q.currentIndex
      })
    }
    this.queueList = list
  },

  back() { console.log('[ui] mode back'); router.back() },

  choose(mode) {
    console.log('[ui] mode choose ' + mode)
    if (ui.offlineToast(state)) { return }
    const rpc = rpcMod.getRpc()
    if (!rpc) { return }
    // 单选写入 playback.setMode；回包 player.mode 生效；本地持久化上次模式
    rpc.setMode(mode, () => {
      store.instance.setLastMode(mode)
    })
  },

  play(index) {
    if (ui.offlineToast(state)) { return }
    const rpc = rpcMod.getRpc()
    if (rpc) { rpc.queuePlay(index) }
  }
}
</script>
