{
  "package": "com.lightningteam.suchmusic",
  "name": "SuchMusic",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    { "name": "system.interconnect" },
    { "name": "system.storage" },
    { "name": "system.router" },
    { "name": "system.file" }
  ],
  "config": {
    "designWidth": 106,
    "background": "#F1F2F4"
  },
  "permissions": [
    { "origin": "*" }
  ],
  "router": {
    "entry": "pages/index/index",
    "pages": {
      "pages/index/index": { "launchMode": "singleTask" },
      "pages/control/index": { "launchMode": "standard" },
      "pages/search/index": { "launchMode": "standard" },
      "pages/mode/index": { "launchMode": "standard" },
      "pages/lyric/index": { "launchMode": "standard" }
    }
  }
}
