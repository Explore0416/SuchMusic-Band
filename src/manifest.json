{
  "package": "com.lightningteam.suchmusic",
  "name": "SuchMusic",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    { "name": "system.interconnect" },
    { "name": "system.storage" },
    { "name": "system.router" },
    { "name": "system.file" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 106
  },
  "permissions": [
    { "origin": "*" }
  ],
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": { "component": "index", "launchMode": "singleTask" },
      "pages/control": { "component": "index", "launchMode": "standard" },
      "pages/search": { "component": "index", "launchMode": "standard" },
      "pages/mode": { "component": "index", "launchMode": "standard" },
      "pages/lyric": { "component": "index", "launchMode": "standard" }
    }
  }
}
