<script>
import { createLink } from './utils/interconnect.js'
import rpcMod from './utils/rpc.js'
import state from './utils/state.js'
import store from './utils/store.js'

/**
 * app.ux —— 全局生命周期（仅 `<script>`，符合 Vela 规范）
 *
 * 设计要点：**启动绝不允许被异常阻断**。
 *   onCreate 全流程包在 try/catch 内；任何失败都写入 state.initError，
 *   由首页可见地呈现，而不是让应用停在启动页。
 */
export default {
  data: {
    link: null,
    rpc: null
  },

  onCreate() {
    try {
      // 1) 建立 interconnect 连接（单例），启动 readyState 轮询（F3）
      const link = createLink({
        pollIntervalMs: 2000,
        onLog: (m) => { console.log('[link] ' + m) }
      })

      // 2) 载入受限持久化（仅 4 类键，<2KB）
      store.instance.load(() => {})

      // 3) 初始化 rpc（单例），挂载消息/状态监听；握手由 onStatus 触发
      const rpc = rpcMod.initRpc({
        link: link,
        state: state,
        store: store.instance,
        origin: 'b',
        onLog: (m) => { console.log('[rpc] ' + m) }
      })

      this.link = link
      this.rpc = rpc

      link.start()
      rpc.attach()

      state.set({ initError: '' })
      console.log('[app] SuchMusic band app created')
    } catch (e) {
      const msg = (e && (e.message || e.name)) || String(e)
      try { state.set({ initError: '启动异常：' + msg }) } catch (e2) { /* 忽略 */ }
      console.log('[app] init error: ' + msg)
    }
  },

  onDestroy() {
    try {
      if (this.link) { this.link.stop() }
    } catch (e) { /* 忽略 */ }
    console.log('[app] destroyed')
  }
}
</script>
